{
  "name": "ogori-training-plan",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && npm run check:server && npm run build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "check:server": "tsc -p tsconfig.functions.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "dev:api": "wrangler pages dev dist --ip 127.0.0.1 --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply ogori-training --local",
    "db:seed:local": "wrangler d1 execute ogori-training --local --file .private/seed.sql",
    "prepare:migration": "node --experimental-strip-types scripts/prepare-migration.ts",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "jose": "^6.2.17",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.159.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
