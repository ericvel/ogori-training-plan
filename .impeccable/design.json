      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Cobalt action with color-only hover feedback.",
      "html": "<button class=\"ds-button ds-primary\">Import Garmin CSV</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;border:1px solid #cbd4e2;background:#fff;color:var(--ink,#243249);border-radius:8px;padding:10px 15px;font:550 13px -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;white-space:nowrap;cursor:pointer;transition:background-color 160ms,border-color 160ms}.ds-button:hover:not(:disabled){background:#f0f4fa;border-color:#9aaac0}.ds-button:disabled{cursor:not-allowed;opacity:.5}.ds-button:focus-visible{outline:3px solid #86aaf2;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-primary{background:var(--blue,#2859bd);border-color:var(--blue,#2859bd);color:#fff}.ds-primary:hover:not(:disabled){background:#204a9e;border-color:#204a9e}"
    },
